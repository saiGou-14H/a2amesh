{
  "$id": "https://a2amesh.dev/schemas/nats-stream-open-request-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "streamOpenId",
    "operation",
    "taskId",
    "callerInstanceId",
    "requestDigest",
    "expiresAt",
    "configGeneration"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "streamOpenId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "operation": {"enum": ["SendStreamingMessage", "SubscribeToTask"]},
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "callerInstanceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "requestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "configGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
