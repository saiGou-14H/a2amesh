{
  "$id": "https://a2amesh.dev/schemas/nats-stream-session-opened-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "streamSessionId",
    "streamOpenId",
    "taskId",
    "operation",
    "callerDeliverySubject",
    "snapshotEventSeq",
    "expiresAt",
    "initialFrame"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "streamSessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "streamOpenId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "operation": {
      "enum": ["SendStreamingMessage", "SubscribeToTask"]
    },
    "callerDeliverySubject": {
      "type": "string",
      "pattern": "^_DELIVER\\.a2amesh\\.stream\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "snapshotEventSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "initialFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "streamSessionId",
        "streamOpenId",
        "sequence",
        "eventSeq",
        "final",
        "canonicalStreamResponse",
        "payloadDigest"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "streamSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "streamOpenId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sequence": {"const": 0},
        "eventSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "final": {"type": "boolean"},
        "canonicalStreamResponse": {"type": "object"},
        "payloadDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
