{
  "$id": "https://a2amesh.dev/schemas/nats-stream-ack-request-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "streamSessionId",
    "streamOpenId",
    "sequence",
    "eventSeq",
    "payloadDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "streamSessionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "streamOpenId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payloadDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
